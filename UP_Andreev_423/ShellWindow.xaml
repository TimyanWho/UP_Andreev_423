<Window x:Class="UP_Andreev_423.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши"
        Height="720"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SideButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="#2F3542"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#202430">
            <StackPanel VerticalAlignment="Top" Margin="0,14,0,0">
                <Button Content="📚" Style="{StaticResource SideButtonStyle}" Tag="Catalog" ToolTip="Каталог книг" Click="Nav_Click"/>
                <Button Content="🗂" Style="{StaticResource SideButtonStyle}" Tag="Lists" ToolTip="Списки книг" Click="Nav_Click"/>
                <Button x:Name="AdminButton" Content="🛡" Style="{StaticResource SideButtonStyle}" Tag="Admin" ToolTip="Администрирование" Click="Nav_Click"/>
                <Button x:Name="AuthorButton" Content="✍" Style="{StaticResource SideButtonStyle}" Tag="Author" ToolTip="Страница автора" Click="Nav_Click"/>
                <Button x:Name="FrozenButton" Content="⚠" Style="{StaticResource SideButtonStyle}" ToolTip="Аккаунт заморожен" Click="Frozen_Click"/>
                <Button Content="👤" Style="{StaticResource SideButtonStyle}" Tag="Profile" ToolTip="Профиль" Click="Nav_Click"/>
                <Button Content="⏻" Style="{StaticResource SideButtonStyle}" ToolTip="Выйти" Click="Logout_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock x:Name="HeaderTextBlock"
                               Text="Читай, Пиши и не спиши"
                               FontSize="22"
                               FontWeight="Bold"
                               DockPanel.Dock="Left"/>
                    <TextBlock x:Name="UserInfoText"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="#666"/>
                </DockPanel>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>