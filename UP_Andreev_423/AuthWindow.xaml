<Window x:Class="UP_Andreev_423.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#E9EEF6">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="390">
                <TextBlock Text="Читай, Пиши и не спиши"
                           FontSize="30"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Платформер для книг тайни эсс авторов"
                           FontSize="16"
                           TextAlignment="Center"
                           Foreground="#555"/>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1"
                Background="White"
                Padding="28"
                CornerRadius="18"
                Margin="20"
                BorderBrush="#D9D9D9"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Вход"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Логин"/>
                <TextBox x:Name="LoginBox" Margin="0,4,0,10"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,4,0,16"/>

                <Button Content="Войти"
                        Height="38"
                        Margin="0,0,0,20"
                        Click="Login_Click"/>

                <Separator Margin="0,0,0,20"/>

                <TextBlock Text="Регистрация"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Имя"/>
                <TextBox x:Name="RegNameBox" Margin="0,4,0,10"/>

                <TextBlock Text="Логин"/>
                <TextBox x:Name="RegLoginBox" Margin="0,4,0,10"/>

                <TextBlock Text="Email"/>
                <TextBox x:Name="RegEmailBox" Margin="0,4,0,10"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="RegPasswordBox" Margin="0,4,0,16"/>

                <Button Content="Зарегистрироваться"
                        Height="38"
                        Click="Register_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>