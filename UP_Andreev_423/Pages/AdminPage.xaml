<Page x:Class="UP_Andreev_423.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора"
      Background="#F3F3F3">

    <TabControl Margin="10">
        <!-- Пользователи -->
        <TabItem Header="👥 Пользователи">
            <Grid Margin="10">
                <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="50"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding FullName}" Width="150"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="80"/>
                        <DataGridTemplateColumn Header="Действия" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🔒 Пароль" Click="ChangePassword_Click" Tag="{Binding UserId}" FontSize="11" Margin="0,0,4,0"/>
                                        <Button Content="❄️ Заморозить" Click="FreezeUser_Click" Tag="{Binding UserId}" FontSize="11" Margin="0,0,4,0"/>
                                        <Button Content="☀️ Разморозить" Click="UnfreezeUser_Click" Tag="{Binding UserId}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- Жалобы -->
        <TabItem Header="⚠️ Жалобы">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ComplaintStatusFilter" SelectedIndex="0" Width="120" SelectionChanged="ComplaintStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Все"/>
                        <ComboBoxItem Content="Новая"/>
                        <ComboBoxItem Content="Принята"/>
                        <ComboBoxItem Content="Отклонена"/>
                    </ComboBox>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="ComplaintsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,8" Background="White" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Reason}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="✔ Принять" Click="AcceptComplaint_Click" Tag="{Binding ComplaintId}" Margin="0,0,4,0"/>
                                            <Button Content="✖ Отклонить" Click="RejectComplaint_Click" Tag="{Binding ComplaintId}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- Заявки на роль -->
        <TabItem Header="📝 Заявки на роль">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="RoleRequestStatusFilter" SelectedIndex="0" Width="120" SelectionChanged="RoleRequestStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Все"/>
                        <ComboBoxItem Content="Новая"/>
                        <ComboBoxItem Content="Принята"/>
                        <ComboBoxItem Content="Отклонена"/>
                    </ComboBox>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="RoleRequestsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,8" Background="White" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UserDisplay}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Motivation}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Status}" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="✔ Принять" Click="AcceptRoleRequest_Click" Tag="{Binding RequestId}" Margin="0,0,4,0"/>
                                            <Button Content="✖ Отклонить" Click="RejectRoleRequest_Click" Tag="{Binding RequestId}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- Запросы на разморозку -->
        <TabItem Header="❄️ Разморозка">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="UnfreezeRequestStatusFilter" SelectedIndex="0" Width="120" SelectionChanged="UnfreezeRequestStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Все"/>
                        <ComboBoxItem Content="Новая"/>
                        <ComboBoxItem Content="Принята"/>
                        <ComboBoxItem Content="Отклонена"/>
                    </ComboBox>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="UnfreezeRequestsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,8" Background="White" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Status}" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="✔ Принять" Click="AcceptUnfreezeRequest_Click" Tag="{Binding RequestId}" Margin="0,0,4,0"/>
                                            <Button Content="✖ Отклонить" Click="RejectUnfreezeRequest_Click" Tag="{Binding RequestId}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- Замороженные книги -->
        <TabItem Header="📚 Замороженные книги">
            <Grid Margin="10">
                <ScrollViewer>
                    <ItemsControl x:Name="FrozenBooksItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,8" Background="White" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FreezeReason}" TextWrapping="Wrap"/>
                                        <Button Content="☀️ Разморозить" Click="UnfreezeBook_Click" Tag="{Binding BookId}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- Замороженные пользователи -->
        <TabItem Header="🔒 Замороженные пользователи">
            <Grid Margin="10">
                <ScrollViewer>
                    <ItemsControl x:Name="FrozenUsersItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,8" Background="White" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Login}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FreezeReason}" TextWrapping="Wrap"/>
                                        <Button Content="☀️ Разморозить" Click="UnfreezeUserFromList_Click" Tag="{Binding UserId}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>
</Page>