<Page x:Class="UP_Andreev_423.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ProfilePage"
      Background="#F3F3F3">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Профиль" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="Имя:" FontWeight="Bold"/>
                <TextBlock Text="..."/>
                <TextBlock Text="Логин:" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="..."/>
                <TextBlock Text="Email:" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="..."/>
                <TextBlock Text="Роль:" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="..."/>

                <Button Content="Подать заявку на роль автора" Margin="0,16,0,0"/>
                <Button Content="Оспорить заморозку" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="14">
            <StackPanel>
                <TextBlock Text="Отзывы пользователя" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Height="500"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>