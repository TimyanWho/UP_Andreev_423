<Page x:Class="UP_Andreev_423.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ProfilePage"
      Background="#F3F3F3">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Профиль" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Имя:" FontWeight="Bold"/>
                    <TextBlock x:Name="NameValueText" Margin="0,0,0,8"/>

                    <TextBlock Text="Логин:" FontWeight="Bold"/>
                    <TextBlock x:Name="LoginValueText" Margin="0,0,0,8"/>

                    <TextBlock Text="Email:" FontWeight="Bold"/>
                    <TextBlock x:Name="EmailValueText" Margin="0,0,0,8"/>

                    <TextBlock Text="Роль:" FontWeight="Bold"/>
                    <TextBlock x:Name="RoleValueText" Margin="0,0,0,8"/>

                    <Border x:Name="FrozenBlock"
                            Background="#FFF2F2"
                            BorderBrush="#E09A9A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,10,0,12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Аккаунт заморожен" FontWeight="Bold" Foreground="#B00020"/>
                            <TextBlock x:Name="FrozenReasonText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Заявка на роль автора" FontWeight="Bold" Margin="0,4,0,4"/>
                    <TextBox x:Name="AuthorRequestReasonBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <Button Content="Подать заявку" Height="36" Margin="0,8,0,0" Click="SendAuthorRequest_Click"/>

                    <TextBlock Text="Оспорить заморозку" FontWeight="Bold" Margin="0,18,0,4"/>
                    <TextBox x:Name="UnfreezeReasonBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <Button Content="Отправить обращение" Height="36" Margin="0,8,0,0" Click="SendUnfreezeRequest_Click"/>

                    <TextBlock x:Name="ProfileStatsText" Margin="0,18,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Мои отзывы" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="UserReviewsItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12" CornerRadius="12" Background="#F8F8F8" BorderBrush="#E3E3E3" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BookTitle}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding RatingText}" Foreground="#666" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <Button Content="Открыть книгу" Width="130" Margin="0,10,0,0" Tag="{Binding}" Click="OpenBook_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>