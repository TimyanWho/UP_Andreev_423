<Page x:Class="UP_Andreev_423.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CatalogPage"
      Background="#F3F3F3">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="240" Margin="0,0,10,0" Height="34" />
                <Button Content="Поиск" Margin="0,0,10,0"/>
                <Button Content="Сорт. по названию" Margin="0,0,10,0"/>
                <Button Content="Сорт. по оценке" Margin="0,0,10,0"/>
                <Button Content="Фильтр по жанру" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14">
            <ScrollViewer>
                <WrapPanel>
                    <Border Width="180" Height="240" Margin="8" Background="#F8F8F8" CornerRadius="10">
                        <StackPanel Margin="10">
                            <TextBlock Text="Название книги" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="Автор" Foreground="#666"/>
                            <TextBlock Text="Жанр" Foreground="#666"/>
                            <Button Content="Открыть" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>