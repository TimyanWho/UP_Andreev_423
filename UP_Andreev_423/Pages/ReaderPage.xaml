<Page x:Class="UP_Andreev_423.Pages.ReaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ReaderPage"
      Background="#F3F3F3">

    <Grid>
        <Border Background="White" CornerRadius="14" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="BookTitleText" FontSize="26" FontWeight="Bold" Margin="0,0,0,14"/>
                    <TextBlock x:Name="BookAuthorText" Foreground="#666" Margin="0,0,0,20"/>
                    <TextBlock x:Name="BookTextBlock" TextWrapping="Wrap" FontSize="16" LineHeight="24"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>