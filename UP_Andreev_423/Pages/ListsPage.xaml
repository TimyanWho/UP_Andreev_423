<Page x:Class="UP_Andreev_423.Pages.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ListsPage"
      Background="#F3F3F3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="250" Height="34" Margin="0,0,10,0"/>
                <Button Content="Поиск" Margin="0,0,10,0" Click="Search_Click"/>
                <Button Content="Сброс" Click="Reset_Click"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">

            <TabItem Header="Заброшено">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AbandonedItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Height="330" Margin="8" Background="White" CornerRadius="14" Padding="12" BorderBrush="#E3E3E3" BorderThickness="1">
                                    <StackPanel>
                                        <Border Height="170" CornerRadius="10" Background="#F2F2F2" ClipToBounds="True">
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,4" Height="40"/>
                                        <TextBlock Text="{Binding Author}" Foreground="#666" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Genres}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding RatingText}" Foreground="#444" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#0A6" Margin="0,4,0,0"/>

                                        <Button Content="Открыть" Margin="0,10,0,0" Tag="{Binding}" Click="OpenBook_Click"/>
                                        <Button Content="Переместить" Margin="0,6,0,0" Tag="{Binding}" Click="MoveStatus_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="В планах">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PlanItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Height="330" Margin="8" Background="White" CornerRadius="14" Padding="12" BorderBrush="#E3E3E3" BorderThickness="1">
                                    <StackPanel>
                                        <Border Height="170" CornerRadius="10" Background="#F2F2F2" ClipToBounds="True">
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,4" Height="40"/>
                                        <TextBlock Text="{Binding Author}" Foreground="#666" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Genres}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding RatingText}" Foreground="#444" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#0A6" Margin="0,4,0,0"/>

                                        <Button Content="Открыть" Margin="0,10,0,0" Tag="{Binding}" Click="OpenBook_Click"/>
                                        <Button Content="Переместить" Margin="0,6,0,0" Tag="{Binding}" Click="MoveStatus_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Читаю">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ReadingItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Height="330" Margin="8" Background="White" CornerRadius="14" Padding="12" BorderBrush="#E3E3E3" BorderThickness="1">
                                    <StackPanel>
                                        <Border Height="170" CornerRadius="10" Background="#F2F2F2" ClipToBounds="True">
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,4" Height="40"/>
                                        <TextBlock Text="{Binding Author}" Foreground="#666" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Genres}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding RatingText}" Foreground="#444" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#0A6" Margin="0,4,0,0"/>

                                        <Button Content="Открыть" Margin="0,10,0,0" Tag="{Binding}" Click="OpenBook_Click"/>
                                        <Button Content="Переместить" Margin="0,6,0,0" Tag="{Binding}" Click="MoveStatus_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Прочитано">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FinishedItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Height="330" Margin="8" Background="White" CornerRadius="14" Padding="12" BorderBrush="#E3E3E3" BorderThickness="1">
                                    <StackPanel>
                                        <Border Height="170" CornerRadius="10" Background="#F2F2F2" ClipToBounds="True">
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,4" Height="40"/>
                                        <TextBlock Text="{Binding Author}" Foreground="#666" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Genres}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding RatingText}" Foreground="#444" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#0A6" Margin="0,4,0,0"/>

                                        <Button Content="Открыть" Margin="0,10,0,0" Tag="{Binding}" Click="OpenBook_Click"/>
                                        <Button Content="Переместить" Margin="0,6,0,0" Tag="{Binding}" Click="MoveStatus_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Page>