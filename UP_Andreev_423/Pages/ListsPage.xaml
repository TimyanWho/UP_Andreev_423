<Page x:Class="UP_Andreev_423.Pages.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ListsPage"
      Background="#F3F3F3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Заброшено" Margin="0,0,8,0"/>
                <Button Content="В планах" Margin="0,0,8,0"/>
                <Button Content="Читаю" Margin="0,0,8,0"/>
                <Button Content="Прочитано" Margin="0,0,8,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14">
            <ScrollViewer>
                <WrapPanel>
                    <Border Width="180" Height="240" Margin="8" Background="#F8F8F8" CornerRadius="10">
                        <StackPanel Margin="10">
                            <TextBlock Text="Книга" FontWeight="Bold"/>
                            <TextBlock Text="Автор" Foreground="#666"/>
                            <Button Content="Переместить" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>