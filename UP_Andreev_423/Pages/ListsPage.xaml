<Page x:Class="UP_Andreev_423.Pages.ListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ListsPage"
      Background="#F3F3F3">

    <Page.Resources>
        <DataTemplate x:Key="BookListCardTemplate">
            <Border Width="230" Margin="8" Background="White" CornerRadius="14" Padding="12" BorderBrush="#E3E3E3" BorderThickness="1">
                <StackPanel>
                    <Border Height="170" Background="#F2F2F2" CornerRadius="10" ClipToBounds="True">
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,4" Height="40"/>
                    <TextBlock Text="{Binding Author}" Foreground="#666" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Genres}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding RatingText}" Foreground="#444" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="#0A6" Margin="0,4,0,0"/>

                    <Button Content="Открыть" Margin="0,10,0,0" Click="OpenBook_Click" Tag="{Binding}"/>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Заброшено" Margin="0,0,6,6" Tag="Заброшено" Click="MoveStatus_Click"/>
                        <Button Content="В планах" Margin="0,0,6,6" Tag="В планах" Click="MoveStatus_Click"/>
                        <Button Content="Читаю" Margin="0,0,6,6" Tag="Читаю" Click="MoveStatus_Click"/>
                        <Button Content="Прочитано" Margin="0,0,6,6" Tag="Прочитано" Click="MoveStatus_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <WrapPanel>
                <TextBox x:Name="SearchBox" Width="250" Height="34" Margin="0,0,10,0"/>
                <Button Content="Поиск" Margin="0,0,10,0" Click="ApplyFilters_Click"/>
                <Button Content="Сброс" Margin="0,0,16,0" Click="Reset_Click"/>

                <ComboBox x:Name="SortBox" Width="160" Margin="0,0,10,0" SelectionChanged="ApplyFilters_Click">
                    <ComboBoxItem Content="По названию"/>
                    <ComboBoxItem Content="По рейтингу"/>
                </ComboBox>

                <ComboBox x:Name="GenreBox" Width="180" SelectionChanged="ApplyFilters_Click"/>
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Заброшено">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AbandonedItems" ItemTemplate="{StaticResource BookListCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="В планах">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PlanItems" ItemTemplate="{StaticResource BookListCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Читаю">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ReadingItems" ItemTemplate="{StaticResource BookListCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Прочитано">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FinishedItems" ItemTemplate="{StaticResource BookListCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>