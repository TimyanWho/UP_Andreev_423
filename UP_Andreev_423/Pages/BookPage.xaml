<Page x:Class="UP_Andreev_423.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BookPage"
      Background="#F3F3F3">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,12,0">
            <StackPanel>
                <Border Height="320" Background="#EAEAEA" CornerRadius="12"/>
                <Button Content="Добавить в список" Margin="0,12,0,0"/>
                <Button Content="Жалоба на книгу" Margin="0,8,0,0"/>
                <Button Content="Жалоба на автора" Margin="0,8,0,0"/>
                <Button Content="Жалоба на отзыв" Margin="0,8,0,0"/>
                <Button Content="Заморозить книгу / отзыв" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="14">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="Название книги" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Автор" Margin="0,4,0,0" Foreground="#666"/>
                    <TextBlock Text="Жанры: ..." Margin="0,4,0,0" Foreground="#666"/>
                    <TextBlock Text="Рейтинг: 4.8" Margin="0,4,0,12" Foreground="#666"/>

                    <TextBlock Text="Описание" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Text="Здесь будет полное описание книги." />

                    <TextBlock Text="Текст книги" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,6"/>
                    <TextBlock TextWrapping="Wrap" Text="Здесь будет полный текст книги для чтения." />

                    <TextBlock Text="Отзывы" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,6"/>
                    <DataGrid Height="200" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>