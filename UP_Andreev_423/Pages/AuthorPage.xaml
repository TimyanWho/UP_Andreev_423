<Page x:Class="UP_Andreev_423.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AuthorPage"
      Background="#F3F3F3">

    <Page.Resources>
        <DataTemplate x:Key="AuthorBookCardTemplate">
            <Border Width="250" Margin="8" Background="White" CornerRadius="14" Padding="12" BorderBrush="#E3E3E3" BorderThickness="1">
                <StackPanel>
                    <Border Height="170" Background="#F2F2F2" CornerRadius="10" ClipToBounds="True">
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,4"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#666"/>
                    <TextBlock Text="{Binding RatingText}" Foreground="#444" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding FreezeText}" Foreground="#B00020" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    <Button Content="Открыть" Margin="0,10,0,0" Click="OpenBook_Click" Tag="{Binding}"/>
                    <Button Content="Редактировать" Margin="0,6,0,0" Click="EditBook_Click" Tag="{Binding}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить книгу" Height="36" Margin="0,0,10,0" Click="AddBook_Click"/>
                <Button Content="Обновить" Height="36" Click="Reload_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AuthorBooksItems" ItemTemplate="{StaticResource AuthorBookCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>