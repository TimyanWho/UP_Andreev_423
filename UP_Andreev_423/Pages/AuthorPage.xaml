<Page x:Class="UP_Andreev_423.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет автора"
      Background="#F3F3F3">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои книги" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="➕ Новая книга" Click="AddBook_Click" Width="120" />
            <Button Content="🔄 Обновить" Click="Reload_Click" Width="100" Margin="8,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Visibility="{Binding CreateFormVisibility}" MaxHeight="400" Margin="0,0,0,12">
            <Border Background="White" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="Новая книга" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Обложка (Win + .):" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="EmojiBox" Width="60" Text="📘" FontSize="24" TextAlignment="Center" MaxLength="2"/>
                        <TextBlock Text="(напр. 📘📕📗📙)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Название:"/>
                        <TextBox x:Name="TitleBox" Height="28"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Описание:"/>
                        <TextBox x:Name="DescriptionBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Текст книги:"/>
                        <TextBox x:Name="ContentBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Жанры:"/>
                        <ListBox x:Name="GenresListBox" SelectionMode="Multiple" Height="100">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GenreName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾 Сохранить" Click="SaveBook_Click" Width="100"/>
                        <Button Content="Отмена" Click="CancelCreate_Click" Width="80" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <ScrollViewer Grid.Row="3" Margin="0,12,0,0">
            <ItemsControl x:Name="AuthorBooksItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="300" Margin="8" Background="White" CornerRadius="14" Padding="12" BorderBrush="#E3E3E3" BorderThickness="1">
                            <StackPanel>
                                <Border Height="130" CornerRadius="10" Background="#F2F2F2" ClipToBounds="True">
                                    <TextBlock Text="{Binding CoverEmoji}" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,4" Height="36"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="#666"/>
                                <TextBlock Text="{Binding RatingText}" Foreground="#444" Margin="0,2,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Открыть" Tag="{Binding BookId}" Click="OpenBook_Click" Width="65" FontSize="11" Padding="4,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>