<Page x:Class="UP_Andreev_423.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AuthorPage"
      Background="#F3F3F3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить книгу" Margin="0,0,8,0"/>
                <Button Content="Редактировать книгу" Margin="0,0,8,0"/>
                <Button Content="Замороженные книги" Margin="0,0,8,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14">
            <DataGrid x:Name="AuthorBooksGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"/>
        </Border>
    </Grid>
</Page>