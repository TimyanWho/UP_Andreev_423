<Window x:Class="UP_Andreev_423.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши"
        Height="720"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SideButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="#2F3542"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="ToolTipService.ShowDuration" Value="5000"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#2F3542"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- AUTH VIEW -->
        <Grid x:Name="AuthView">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#ECEFF4" Offset="0"/>
                    <GradientStop Color="#DDE6F2" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Border Width="430"
                    Padding="24"
                    CornerRadius="16"
                    Background="White"
                    BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Читай, Пиши и не спиши"
                               FontSize="26"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Вход в систему"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Логин"/>
                    <TextBox x:Name="LoginBox" />

                    <TextBlock Text="Пароль"/>
                    <PasswordBox x:Name="PasswordBoxAuth" />

                    <Button Content="Войти"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Login_Click"
                            Margin="0,8,0,0"/>

                    <Separator Margin="0,16,0,16"/>

                    <TextBlock Text="Регистрация"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Имя"/>
                    <TextBox x:Name="RegNameBox" />

                    <TextBlock Text="Логин"/>
                    <TextBox x:Name="RegLoginBox" />

                    <TextBlock Text="Email"/>
                    <TextBox x:Name="RegEmailBox" />

                    <TextBlock Text="Пароль"/>
                    <PasswordBox x:Name="RegPasswordBox" />

                    <Button Content="Зарегистрироваться"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Register_Click"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN VIEW -->
        <Grid x:Name="MainView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#202430">
                <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                    <Button Style="{StaticResource SideButtonStyle}" Content="📚" Tag="Catalog" ToolTip="Каталог книг" Click="Nav_Click"/>
                    <Button Style="{StaticResource SideButtonStyle}" Content="🗂" Tag="Lists" ToolTip="Списки книг" Click="Nav_Click"/>
                    <Button Style="{StaticResource SideButtonStyle}" Content="👤" Tag="Profile" ToolTip="Профиль" Click="Nav_Click"/>
                    <Button Style="{StaticResource SideButtonStyle}" Content="✍" Tag="Author" ToolTip="Страница автора" Click="Nav_Click"/>
                    <Button Style="{StaticResource SideButtonStyle}" Content="🛡" Tag="Admin" ToolTip="Администрирование" Click="Nav_Click"/>
                    <Button Style="{StaticResource SideButtonStyle}" Content="⏻" ToolTip="Выйти" Click="Logout_Click"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                    <TextBlock Text="Прототип приложения"
                               FontSize="22"
                               FontWeight="Bold"/>
                </Border>

                <Grid Grid.Row="1">
                    <!-- CATALOG PAGE -->
                    <Grid x:Name="CatalogPage" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="260" x:Name="CatalogSearchBox" Margin="0,0,10,0" />
                                <Button Content="Поиск" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Сорт. по названию" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Сорт. по оценке" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Фильтр жанры" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14">
                            <Grid>
                                <DataGrid x:Name="BooksGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- LISTS PAGE -->
                    <Grid x:Name="ListsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Заброшено" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="В планах" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Читаю" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Прочитано" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14">
                            <Grid>
                                <DataGrid x:Name="ListsGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PROFILE PAGE -->
                    <Grid x:Name="ProfilePage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Профиль" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Имя:" FontWeight="Bold"/>
                                <TextBlock Text="Пользователь" Margin="0,0,0,10"/>
                                <TextBlock Text="Логин:" FontWeight="Bold"/>
                                <TextBlock Text="login" Margin="0,0,0,10"/>
                                <TextBlock Text="Email:" FontWeight="Bold"/>
                                <TextBlock Text="mail@example.com" Margin="0,0,0,10"/>
                                <TextBlock Text="Роль:" FontWeight="Bold"/>
                                <TextBlock Text="Читатель" Margin="0,0,0,20"/>

                                <Button Content="Подать заявку на автора" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Оспорить заморозку" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="14">
                            <Grid>
                                <DataGrid x:Name="UserReviewsGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- AUTHOR PAGE -->
                    <Grid x:Name="AuthorPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Добавить книгу" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Редактировать" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="Замороженные" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14">
                            <Grid>
                                <DataGrid x:Name="AuthorBooksGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ADMIN PAGE -->
                    <Grid x:Name="AdminPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="0" Background="White" CornerRadius="14" Padding="14" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Жалобы" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid x:Name="ComplaintsGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Height="240"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="0" Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Заявки" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid x:Name="RequestsGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Height="240"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="1" Background="White" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Замороженные пользователи" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid x:Name="FrozenUsersGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Height="240"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="1" Background="White" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Пользователи" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid x:Name="UsersGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Height="240"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>